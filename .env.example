# S2DCMS Environment Variables for Docker Compose
# Copy this file to .env and replace placeholder values with your actual credentials.
# This file is gitignored - never commit real credentials!

# === Database ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=s2dcmsdb

# === Redis ===
# Redis doesn't need username/password in this setup,
# but you can add REDIS_PASSWORD if using Redis with auth

# === RabbitMQ ===
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# === Backend Application ===
# Spring Boot application properties
ENVIRONMENT=development

# Brevo (SendGrid) Email Service API Key
# Required for email functionality (verify, reset, contact endpoints)
BREVO_API_KEY=your_brevo_api_key_here

# Frontend application base URL
# Used for CORS and cookie same-site configuration
FRONTEND_BASE_URL=http://localhost:5173

# === Render Production (set via Render dashboard env vars, not .env) ===
# These are typically set as environment variables on the Render service
# and take precedence over .env file values:
# - SUPABASE_URL
# - SUPABASE_ANON_KEY
# - SUPABASE_SERVICE_ROLE_KEY
# - REDIS_CLOUD_URL
# - CLOUDAMQP_URL
# - GRAFANA_CLOUD_PROMETHEUS_WRITE_KEY